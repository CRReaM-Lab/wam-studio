# Url of the wam-bank service.
BACKEND_URL=http://localhost:6002
# Url of the wam-bank service or other server that provides the music specified in the songs.json
SONGS_FILE_URL=http://localhost:6002
# Url of the Raspberry transfer agent (absolute, or relative to the page, e.g. /agent).
# Default: http://localhost:3100
AGENT_TRANSFERT_URL=http://localhost:3100
# Url of the Raspberry server WebSocket. Empty: ws(s)://<page host>:8383.
# Relative (e.g. /ws) when the server that serves the page also carries the WebSocket.
RASPBERRY_WS_URL=
# Enable or not the HTTPS in dev mode to use Docker in developpement mode.
HTTPS_DEV=false